# O Jarvis usa o Claude Code logado com a sua assinatura do Claude — não precisa de chave de API.

# Como o Jarvis te chama
JARVIS_USER_NAME=senhor

# 1 = só responde quando você diz "Jarvis ..." (bom se tem TV/pessoas conversando perto)
JARVIS_WAKE_WORD=0

# Modelo: vazio = padrão do seu Claude Code. "sonnet" responde mais rápido e gasta menos do seu limite.
JARVIS_MODEL=

# Voz: pt-BR-AntonioNeural (masculina) ou pt-BR-FranciscaNeural (feminina)
JARVIS_VOICE=pt-BR-AntonioNeural

# Tom e velocidade da voz, e o efeito metálico de IA (1 = ligado)
JARVIS_PITCH=-8Hz
JARVIS_RATE=+0%
JARVIS_FX=1

# Reconhecimento de voz: tiny, base, small, medium (maior = mais preciso e mais lento)
JARVIS_WHISPER=small
